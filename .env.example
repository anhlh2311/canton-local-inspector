# Deployment mode: "local" (uses Vite proxy) or "vercel" (uses serverless functions)
VITE_DEPLOY_ENV=local

# Pre-configured node (displayed by default when VITE_DEPLOY_ENV=vercel)
VITE_NODE_NAME=Devnet Validator
VITE_NODE_COLOR=#ec4899
VITE_JSON_API_URL=http://your-json-api-url:7575/api/json-api
VITE_VALIDATOR_API_URL=http://your-validator-api-url:5003
VITE_AUTH_MODE=oauth2

# Server-side only (NOT prefixed with VITE_ — never bundled into client code)
# These are used by Vercel Serverless Functions
CANTON_JSON_API_URL=http://your-json-api-url:7575/api/json-api
CANTON_VALIDATOR_API_URL=http://your-validator-api-url:5003
CANTON_OAUTH2_TOKEN_URL=https://your-tenant.auth0.com/oauth/token
CANTON_OAUTH2_CLIENT_ID=your-client-id
CANTON_OAUTH2_CLIENT_SECRET=your-client-secret
CANTON_OAUTH2_AUDIENCE=https://your-api-audience
CANTON_OAUTH2_VALIDATOR_AUDIENCE=https://your-validator-audience
