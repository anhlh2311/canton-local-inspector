# ============================================================================
# Canton Local Inspector — Environment Variables
# ============================================================================

# Deployment mode: "local" (uses Vite proxy) or "vercel" (uses serverless functions)
VITE_DEPLOY_ENV=local

# ============================================================================
# Option 1: VITE_NODES — Configure multiple nodes as a JSON array
# ============================================================================
# Supports any mix of local and remote nodes. This takes priority over all
# other node config methods. Each node needs: id, name, jsonApiUrl, color.
#
# VITE_NODES='[
#   {
#     "id": "trading-partner",
#     "name": "Trading Partner",
#     "jsonApiUrl": "http://localhost",
#     "jsonApiPort": 1975,
#     "validatorApiUrl": "http://localhost",
#     "validatorApiPort": 1903,
#     "color": "#3b82f6",
#     "authMode": "shared-secret"
#   },
#   {
#     "id": "app-user",
#     "name": "App User",
#     "jsonApiUrl": "http://localhost",
#     "jsonApiPort": 2975,
#     "validatorApiUrl": "http://localhost",
#     "validatorApiPort": 2903,
#     "color": "#22c55e",
#     "authMode": "shared-secret"
#   },
#   {
#     "id": "devnet",
#     "name": "Devnet Validator",
#     "jsonApiUrl": "<your-json-api-url>",
#     "validatorApiUrl": "<your-validator-api-url>",
#     "color": "#ec4899",
#     "authMode": "oauth2",
#     "audience": "<your-audience>",
#     "validatorAudience": "<your-validator-audience>"
#   }
# ]'

# ============================================================================
# Option 2: Single node via individual VITE_* vars (simpler for one node)
# ============================================================================
# Used when VITE_NODES is not set. Good for Vercel with a single remote node.
#
# VITE_NODE_NAME=Devnet Validator
# VITE_NODE_COLOR=#ec4899
# VITE_JSON_API_URL=<your-json-api-url>
# VITE_JSON_API_PORT=0
# VITE_VALIDATOR_API_URL=<your-validator-api-url>
# VITE_VALIDATOR_API_PORT=0
# VITE_AUTH_MODE=oauth2
# VITE_AUDIENCE=<your-audience>
# VITE_VALIDATOR_AUDIENCE=<your-validator-audience>
#
# For shared-secret auth:
# VITE_AUTH_MODE=shared-secret
# VITE_AUTH_USER_ID=ledger-api-user
# VITE_AUTH_SECRET=unsafe
# VITE_AUTH_ISSUER=unsafe-auth

# ============================================================================
# Option 3: No env vars — defaults to Canton Quickstart local nodes
# ============================================================================
# When neither VITE_NODES nor VITE_JSON_API_URL is set (and not on Vercel),
# the app uses hardcoded quickstart nodes:
#   Trading Partner (:1975), App User (:2975), App Provider (:3975), Super Validator (:4975)

# ============================================================================
# Server-side only (Vercel Serverless Functions)
# ============================================================================
# NOT prefixed with VITE_ — never bundled into client code.
# Used by /api/auth/token and /api/proxy serverless functions.

# --- Proxy allowed targets (comma-separated URLs the proxy can forward to) ---
# CANTON_ALLOWED_TARGETS=<your-json-api-url>,<your-validator-api-url>,<your-other-json-api-url>

# --- Option A: Single node OAuth2 (legacy) ---
# CANTON_JSON_API_URL=<your-json-api-url>
# CANTON_VALIDATOR_API_URL=<your-validator-api-url>
# CANTON_OAUTH2_TOKEN_URL=https://your-tenant.auth0.com/oauth/token
# CANTON_OAUTH2_CLIENT_ID=your-client-id
# CANTON_OAUTH2_CLIENT_SECRET=your-client-secret
# CANTON_OAUTH2_AUDIENCE=https://your-api-audience
# CANTON_OAUTH2_VALIDATOR_AUDIENCE=https://your-validator-audience

# --- Option B: Multi-node OAuth2 (JSON map keyed by node ID from VITE_NODES) ---
# Node IDs must match the "id" field in VITE_NODES.
# CANTON_NODES_AUTH='{"devnet":{"tokenUrl":"https://tenant.auth0.com/oauth/token","clientId":"abc","clientSecret":"secret","audience":"https://devnet-audience","validatorAudience":"https://devnet-validator"},"mainnet":{"tokenUrl":"https://other.auth0.com/oauth/token","clientId":"xyz","clientSecret":"other-secret","audience":"https://mainnet-audience"}}'
