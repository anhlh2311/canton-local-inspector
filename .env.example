# ============================================================================
# Canton Local Inspector — Environment Variables
# ============================================================================

# Deployment mode: "local" (uses Vite proxy) or "vercel" (uses serverless functions)
VITE_DEPLOY_ENV=local

# ============================================================================
# Option 1: VITE_NODES — Configure multiple nodes as a JSON array
# ============================================================================
# Supports any mix of local and remote nodes. This takes priority over all
# other node config methods. Each node needs: id, name, jsonApiUrl, color.
#
# IMPORTANT: Must be a single line — dotenv does not support multiline values.
# For readability, the JSON is shown expanded below, but in the .env file it must be one line.
#
# Each node object supports:
#   id, name, network ("local"|"devnet"|"testnet"|"mainnet"),
#   jsonApiUrl, jsonApiPort, validatorApiUrl, validatorApiPort,
#   color, authMode ("shared-secret" or "oauth2"),
#   adminUser (Canton user ID for granting CanReadAsAnyParty, e.g. "service-account-validator-xxx"),
#   globalSynchronizerId (optional),
#   For shared-secret: userId, secret, audience, issuer
#   For oauth2: audience, validatorAudience (secrets are server-side in CANTON_NODES_AUTH)
#
# Example (single line in .env):
# VITE_NODES=[{"id":"local","name":"Local Node","jsonApiUrl":"http://localhost","jsonApiPort":1975,"validatorApiUrl":"http://localhost","validatorApiPort":1903,"color":"#3b82f6","authMode":"shared-secret"},{"id":"devnet","name":"Devnet","jsonApiUrl":"http://1.2.3.4:7575/api/json-api","validatorApiUrl":"http://1.2.3.4:5003","color":"#ec4899","authMode":"oauth2","audience":"https://my-audience","validatorAudience":"https://my-val-audience"}]

# ============================================================================
# Option 2: Single node via individual VITE_* vars (simpler for one node)
# ============================================================================
# Used when VITE_NODES is not set. Good for Vercel with a single remote node.
#
# VITE_NODE_NAME=Devnet Validator
# VITE_NODE_COLOR=#ec4899
# VITE_JSON_API_URL=<your-json-api-url>
# VITE_JSON_API_PORT=0
# VITE_VALIDATOR_API_URL=<your-validator-api-url>
# VITE_VALIDATOR_API_PORT=0
# VITE_AUTH_MODE=oauth2
# VITE_AUDIENCE=<your-audience>
# VITE_VALIDATOR_AUDIENCE=<your-validator-audience>
#
# For shared-secret auth:
# VITE_AUTH_MODE=shared-secret
# VITE_AUTH_USER_ID=ledger-api-user
# VITE_AUTH_SECRET=unsafe
# VITE_AUTH_ISSUER=unsafe-auth

# ============================================================================
# Option 3: No env vars — defaults to Canton Quickstart local nodes
# ============================================================================
# When neither VITE_NODES nor VITE_JSON_API_URL is set (and not on Vercel),
# the app uses hardcoded quickstart nodes:
#   Trading Partner (:1975), App User (:2975), App Provider (:3975), Super Validator (:4975)

# ============================================================================
# Server-side only (Vercel Serverless Functions)
# ============================================================================
# NOT prefixed with VITE_ — never bundled into client code.
# Used by /api/auth/token and /api/proxy serverless functions.

# --- Google OAuth (user authentication for the web app) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/google-callback
# GOOGLE_CLIENT_ID=<your-google-client-id>
# GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# --- Session secret (signs JWT session cookies, generate with: openssl rand -base64 32) ---
# AUTH_SECRET=<your-random-secret>

# --- Admin email (auto-assigned admin role on first Google login) ---
# ADMIN_EMAIL=admin@example.com

# --- Upstash Redis (stores user accounts, invites, credentials, template index) ---
# Auto-set when linking Upstash Redis via Vercel Marketplace (Storage tab).
# Supports both naming conventions (KV_REST_API_* or UPSTASH_REDIS_REST_*).
# KV_REST_API_URL=<your-url>
# KV_REST_API_TOKEN=<your-token>

# --- Email notifications (optional, for sending invite emails) ---
# Sign up at https://resend.com and get an API key.
# Without this, invites still work but no email is sent — admin tells users the URL manually.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=Canton Inspector <noreply@yourdomain.com>

# --- Cron job security (template indexing cron, generate with: openssl rand -base64 24) ---
# Vercel sends this as Authorization: Bearer header when invoking cron jobs.
# CRON_SECRET=<your-random-secret>

# --- Proxy allowed targets (comma-separated URLs the proxy can forward to) ---
# CANTON_ALLOWED_TARGETS=<your-json-api-url>,<your-validator-api-url>,<your-other-json-api-url>
#
# --- MainNet jump-host gateway (VPN-only ledger). Server-side only — never VITE_*. ---
# Same secret as docker/ledger-gateway/.env. Hosts are hostnames only (no scheme).
# LEDGER_GATEWAY_HOSTS=ledger-gw.example.com
# LEDGER_GATEWAY_SECRET=<openssl rand -hex 32>

# --- Option A: Single node OAuth2 (legacy) ---
# CANTON_JSON_API_URL=<your-json-api-url>
# CANTON_VALIDATOR_API_URL=<your-validator-api-url>
# CANTON_OAUTH2_TOKEN_URL=https://your-tenant.auth0.com/oauth/token
# CANTON_OAUTH2_CLIENT_ID=your-client-id
# CANTON_OAUTH2_CLIENT_SECRET=your-client-secret
# CANTON_OAUTH2_AUDIENCE=https://your-api-audience
# CANTON_OAUTH2_VALIDATOR_AUDIENCE=https://your-validator-audience

# --- Option B: Multi-node OAuth2 (JSON map keyed by node ID from VITE_NODES) ---
# Node IDs must match the "id" field in VITE_NODES.
# CANTON_NODES_AUTH='{"devnet":{"tokenUrl":"https://tenant.auth0.com/oauth/token","clientId":"abc","clientSecret":"secret","audience":"https://devnet-audience","validatorAudience":"https://devnet-validator"},"mainnet":{"tokenUrl":"https://other.auth0.com/oauth/token","clientId":"xyz","clientSecret":"other-secret","audience":"https://mainnet-audience"}}'

# ─── Docker / Local Server ───────────────────────────────────────────────────
# These are used when running via `docker compose up` or `yarn server`.
# DATABASE_URL is automatically set by docker-compose.yml.

# DATABASE_URL=postgresql://canton:canton@localhost:5433/canton_inspector
# CRON_SCHEDULE=*/10 * * * *
# PORT=3000
