# Origin the jump host can reach (VPN-only ledger). No trailing slash.
# Example: https://participant.mainnet.internal:443
LEDGER_UPSTREAM=https://participant.mainnet.internal

# Shared secret. Same value as LEDGER_GATEWAY_SECRET on local + Vercel inspector.
LEDGER_GATEWAY_SECRET=

# Listen port inside the container and on the host.
LEDGER_GATEWAY_PORT=8080
LEDGER_GATEWAY_PUBLISH_PORT=8080
