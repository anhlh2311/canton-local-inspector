# Shared secret. Same value as LEDGER_GATEWAY_SECRET on local + Vercel inspector.
LEDGER_GATEWAY_SECRET=

LEDGER_GATEWAY_PORT=8080
LEDGER_GATEWAY_PUBLISH_PORT=8080

# Public hostnames (Nginx Proxy Manager Proxy Hosts). Must match Host Caddy sees.
LEDGER_GATEWAY_HOSTNAME=inspector-ledger.madeintoilet.com
VALIDATOR_GATEWAY_HOSTNAME=inspector-validator.madeintoilet.com
AUTH_GATEWAY_HOSTNAME=inspector-auth.madeintoilet.com

# VPN-only origins the jump host can reach. No trailing slash.
LEDGER_UPSTREAM=https://participant-validator-angelhack.canton.catalyst.angelhack.com
VALIDATOR_UPSTREAM=https://wallet-validator-angelhack.canton.catalyst.angelhack.com
AUTH_UPSTREAM=https://keycloak.catalyst.angelhack.com
