# Shared secret. Same value as LEDGER_GATEWAY_SECRET on local + Vercel inspector.
LEDGER_GATEWAY_SECRET=

LEDGER_GATEWAY_PORT=8080
LEDGER_GATEWAY_PUBLISH_PORT=8080

# Public hostnames (Nginx Proxy Manager Proxy Hosts). Must match Host Caddy sees.
LEDGER_GATEWAY_HOSTNAME=inspector-ledger.madeintoilet.com
VALIDATOR_GATEWAY_HOSTNAME=inspector-validator.madeintoilet.com
AUTH_GATEWAY_HOSTNAME=inspector-auth.madeintoilet.com

# VPN-only origins the jump host can reach. No trailing slash.
# *_UPSTREAM_HOST is the hostname only (no scheme, no port) — used as the HTTP Host header.
LEDGER_UPSTREAM=https://participant-validator-angelhack.canton.catalyst.angelhack.com
LEDGER_UPSTREAM_HOST=participant-validator-angelhack.canton.catalyst.angelhack.com
VALIDATOR_UPSTREAM=https://wallet-validator-angelhack.canton.catalyst.angelhack.com
VALIDATOR_UPSTREAM_HOST=wallet-validator-angelhack.canton.catalyst.angelhack.com
AUTH_UPSTREAM=https://keycloak.catalyst.angelhack.com
AUTH_UPSTREAM_HOST=keycloak.catalyst.angelhack.com

# Extra nodes on the same three public hostnames. Path is stripped before proxying.
# Inspector jsonApiUrl example: https://inspector-ledger.madeintoilet.com/kairo
# *_UPSTREAM may include an API path (e.g. /api/json-api). Caddy cannot proxy a
# path as the upstream address; the generator keeps scheme/host/port and rewrites
# that path onto the request. jsonApiUrl should be gateway + tenant only (no /api/json-api).
# GATEWAY_TENANTS=kairo,sanctum,mcph
# KAIRO_LEDGER_UPSTREAM=https://kairo-participant.example
# KAIRO_LEDGER_UPSTREAM_HOST=kairo-participant.example
# KAIRO_VALIDATOR_UPSTREAM=https://kairo-validator.example
# KAIRO_VALIDATOR_UPSTREAM_HOST=kairo-validator.example
# KAIRO_AUTH_UPSTREAM=https://kairo-keycloak.example
# KAIRO_AUTH_UPSTREAM_HOST=kairo-keycloak.example
# SANCTUM_LEDGER_UPSTREAM=...
# MCPH_LEDGER_UPSTREAM=...
GATEWAY_TENANTS=
