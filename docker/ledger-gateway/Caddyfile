# Runtime Caddyfile is generated by generate-caddyfile.sh (path prefixes + default routes).
# This copy documents the unprefixed layout only. Do not mount it over the generator.
{
	admin off
}

:{$LEDGER_GATEWAY_PORT:8080} {
	@authed header X-Ledger-Gateway-Secret {$LEDGER_GATEWAY_SECRET}

	handle @authed {
		@ledger host {$LEDGER_GATEWAY_HOSTNAME}
		handle @ledger {
			reverse_proxy {$LEDGER_UPSTREAM} {
				header_up Host {$LEDGER_UPSTREAM_HOST}
				header_up -X-Ledger-Gateway-Secret
			}
		}

		@validator host {$VALIDATOR_GATEWAY_HOSTNAME}
		handle @validator {
			reverse_proxy {$VALIDATOR_UPSTREAM} {
				header_up Host {$VALIDATOR_UPSTREAM_HOST}
				header_up -X-Ledger-Gateway-Secret
			}
		}

		@auth host {$AUTH_GATEWAY_HOSTNAME}
		handle @auth {
			@token {
				method POST
				path_regexp token ^/auth/realms/[^/]+/protocol/openid-connect/token$
			}
			handle @token {
				reverse_proxy {$AUTH_UPSTREAM} {
					header_up Host {$AUTH_UPSTREAM_HOST}
					header_up -X-Ledger-Gateway-Secret
				}
			}
			respond "Not Found" 404
		}

		respond "Not Found" 404
	}

	handle_errors {
		respond "upstream {http.error.status_code}: {http.error.message}" {http.error.status_code}
	}

	respond "Unauthorized" 401
}
